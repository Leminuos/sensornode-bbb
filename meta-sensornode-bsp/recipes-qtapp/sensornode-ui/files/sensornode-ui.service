[Unit]
Description=SensorNode Qt HMI
After=multi-user.target data.mount

[Service]
Type=simple
Environment=TSLIB_TSDEVICE=/dev/input/event0
Environment=TSLIB_CONFFILE=/etc/ts.conf
Environment=TSLIB_CALIBFILE=/etc/pointercal
Environment=TSLIB_FBDEVICE=/dev/fb0
ExecStart=/usr/bin/sensornode-ui -platform linuxfb -plugin=tslib
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
