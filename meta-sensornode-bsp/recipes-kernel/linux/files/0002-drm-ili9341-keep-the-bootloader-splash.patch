From e18f8894f554e988f480140bac26730b45c1353f Mon Sep 17 00:00:00 2001
From: Leminuos <buinguyen2804@gmail.com>
Date: Mon, 2 Nov 2026 21:13:36 +0700
Subject: [PATCH] drm/tiny/ili9341: keep the bootloader splash until userspace
 draws

Without fbcon the pipeline is first enabled by a userspace ioctl such as
FBIOPAN_DISPLAY. When U-Boot has already switched the panel on, that commit
skips the init sequence but still pushes the empty framebuffer, so the
splash blinks black. Skip the enable flush and any undamaged update until
the first damaged update, which carries what userspace drew.

Upstream-Status: Inappropriate [product specific]
---
 drivers/gpu/drm/tiny/ili9341.c | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/tiny/ili9341.c b/drivers/gpu/drm/tiny/ili9341.c
index 37e0c33..c0742c8 100644
--- a/drivers/gpu/drm/tiny/ili9341.c
+++ b/drivers/gpu/drm/tiny/ili9341.c
@@ -50,6 +50,10 @@
 #define ILI9341_MADCTL_MX	BIT(6)
 #define ILI9341_MADCTL_MY	BIT(7)
 
+/* Set while the panel still shows the image U-Boot left on it */
+static bool yx240qv29_keep_boot_image;
+static bool yx240qv29_first_enable = true;
+
 static void yx240qv29_enable(struct drm_simple_display_pipe *pipe,
 			     struct drm_crtc_state *crtc_state,
 			     struct drm_plane_state *plane_state)
@@ -65,6 +69,9 @@ static void yx240qv29_enable(struct drm_simple_display_pipe *pipe,
 	DRM_DEBUG_KMS("\n");
 
 	ret = mipi_dbi_poweron_conditional_reset(dbidev);
+	if (yx240qv29_first_enable)
+		yx240qv29_keep_boot_image = ret == 1;
+	yx240qv29_first_enable = false;
 	if (ret < 0)
 		goto out_exit;
 	if (ret == 1)
@@ -131,15 +138,32 @@ out_enable:
 	}
 	addr_mode |= ILI9341_MADCTL_BGR;
 	mipi_dbi_command(dbi, MIPI_DCS_SET_ADDRESS_MODE, addr_mode);
-	mipi_dbi_enable_flush(dbidev, crtc_state, plane_state);
+	if (!yx240qv29_keep_boot_image)
+		mipi_dbi_enable_flush(dbidev, crtc_state, plane_state);
 out_exit:
 	drm_dev_exit(idx);
 }
 
+static void yx240qv29_update(struct drm_simple_display_pipe *pipe,
+			     struct drm_plane_state *old_state)
+{
+	/*
+	 * A commit without damage would push the still empty framebuffer.
+	 * Wait for the first damage, which means userspace has drawn.
+	 */
+	if (yx240qv29_keep_boot_image) {
+		if (!drm_plane_get_damage_clips_count(pipe->plane.state))
+			return;
+		yx240qv29_keep_boot_image = false;
+	}
+
+	mipi_dbi_pipe_update(pipe, old_state);
+}
+
 static const struct drm_simple_display_pipe_funcs ili9341_pipe_funcs = {
 	.enable = yx240qv29_enable,
 	.disable = mipi_dbi_pipe_disable,
-	.update = mipi_dbi_pipe_update,
+	.update = yx240qv29_update,
 };
 
 static const struct drm_display_mode yx240qv29_mode = {
