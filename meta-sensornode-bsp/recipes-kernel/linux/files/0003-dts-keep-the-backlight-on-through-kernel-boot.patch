From d49c9ce344901473188bd78f42889cb08b6a0651 Mon Sep 17 00:00:00 2001
From: Leminuos <buinguyen2804@gmail.com>
Date: Mon, 2 Nov 2026 20:48:20 +0700
Subject: [PATCH] ARM: dts: am335x-boneblack: keep the backlight on through
 kernel boot

U-Boot turns the backlight on through gpio1_18. The kernel used to reset
GPIO1 and mux the pin to eHRPWM1 before pwm-backlight enabled the PWM, so
the backlight went off for a moment. Keep GPIO1 as U-Boot left it and mux
the pin only when pwm-backlight probes.

Upstream-Status: Inappropriate [product specific]
---
 arch/arm/boot/dts/am335x-boneblack.dts | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/am335x-boneblack.dts b/arch/arm/boot/dts/am335x-boneblack.dts
index a4a7abf..de1434b 100644
--- a/arch/arm/boot/dts/am335x-boneblack.dts
+++ b/arch/arm/boot/dts/am335x-boneblack.dts
@@ -227,6 +227,8 @@
 
 	backlight {
 		compatible = "pwm-backlight";
+		pinctrl-names = "default";
+		pinctrl-0 = <&dimmy_pins>;
 		pwms = <&ehrpwm1 0 1000000 0>;
 		brightness-levels = <0 100>;
 		num-interpolated-steps = <100>;
@@ -297,7 +299,10 @@
 };
 
 &ehrpwm1 {
-	pinctrl-names = "default";
-	pinctrl-0 = <&dimmy_pins>;
 	status = "okay";
+};
+
+/* GPIO1 holds the backlight pin that U-Boot drives high */
+&{/ocp/interconnect@48000000/segment@0/target-module@4c000} {
+	ti,no-reset-on-init;
 };
\ No newline at end of file
