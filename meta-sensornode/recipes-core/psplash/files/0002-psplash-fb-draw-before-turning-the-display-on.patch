From 11f2d3d70aedf62cd1c6e717a7139297eefcc88d Mon Sep 17 00:00:00 2001
From: Leminuos <buinguyen2804@gmail.com>
Date: Wed, 4 Nov 2026 21:56:18 +0700
Subject: [PATCH] psplash-fb: draw before turning the display on

On a DRM fbdev emulation without fbcon, the first FBIOPAN_DISPLAY enables
the pipeline and flushes the whole buffer to the panel. Doing it from the
double buffering probe pushed an empty buffer over the bootloader splash.
Pan once after the first frame instead, and drop the probe.

Upstream-Status: Inappropriate [sensornode specific]
---
 psplash-fb.c | 41 +++++++++++++++++------------------------
 psplash-fb.h |  3 +++
 psplash.c    |  2 ++
 3 files changed, 22 insertions(+), 24 deletions(-)

diff --git a/psplash-fb.c b/psplash-fb.c
index 2babb5f..f9d9d13 100644
--- a/psplash-fb.c
+++ b/psplash-fb.c
@@ -50,6 +50,20 @@ psplash_fb_flip(PSplashFB *fb, int sync)
   }
 }
 
+void
+psplash_fb_show(PSplashFB *fb)
+{
+  struct fb_var_screeninfo fb_var;
+
+  /* mmap writes reach the panel buffer from a kernel worker */
+  fsync(fb->fd);
+  usleep(100000);
+
+  if (ioctl(fb->fd, FBIOGET_VSCREENINFO, &fb_var) == -1 ||
+      ioctl(fb->fd, FBIOPAN_DISPLAY, &fb_var) == -1)
+    perror("Error turning the display on");
+}
+
 void
 psplash_fb_destroy (PSplashFB *fb)
 {
@@ -195,30 +209,9 @@ psplash_fb_new (int angle, int fbdev_id)
       goto fail;
     }
 
-  /* Setup double virtual resolution for double buffering */
-  if (ioctl(fb->fd, FBIOPAN_DISPLAY, &fb_var) == -1) {
-    fprintf(stderr, "warning: FBIOPAN_DISPLAY not supported, "
-                    "double buffering disabled\n");
-  } else {
-    if (fb_var.yres_virtual == fb_var.yres * 2) {
-      DBG("Virtual resolution already double");
-      fb->double_buffering = 1;
-    } else {
-      fb_var.yres_virtual = fb_var.yres * 2;
-      if (ioctl(fb->fd, FBIOPUT_VSCREENINFO, &fb_var) == -1) {
-        fprintf(stderr, "warning: FBIOPUT_VSCREENINFO failed, "
-                        "double buffering disabled\n");
-      } else {
-        if (ioctl(fb->fd, FBIOGET_FSCREENINFO, &fb_fix) == -1) {
-          perror(" Error getting the fixed framebuffer info");
-          goto fail;
-        } else {
-          DBG("Virtual resolution set to double");
-          fb->double_buffering = 1;
-        }
-      }
-    }
-  }
+  /* The first pan turns the panel on and sends whatever the buffer holds,
+   * so it waits for psplash_fb_show() after the first frame is drawn.
+   * That also gives up double buffering, which fbdev emulation lacks. */
 
   fb->real_width  = fb->width  = fb_var.xres;
   fb->real_height = fb->height = fb_var.yres;
diff --git a/psplash-fb.h b/psplash-fb.h
index 16e2b20..3669695 100644
--- a/psplash-fb.h
+++ b/psplash-fb.h
@@ -94,4 +94,7 @@ psplash_fb_draw_text (PSplashFB         *fb,
 void
 psplash_fb_flip(PSplashFB *fb, int sync);
 
+void
+psplash_fb_show(PSplashFB *fb);
+
 #endif
diff --git a/psplash.c b/psplash.c
index ee1af6b..d287ed7 100644
--- a/psplash.c
+++ b/psplash.c
@@ -341,6 +341,8 @@ main (int argc, char** argv)
    */
   psplash_fb_flip(fb, 1);
 
+  psplash_fb_show(fb);
+
   psplash_main (fb, pipe_fd, 0);
 
   psplash_fb_destroy (fb);
