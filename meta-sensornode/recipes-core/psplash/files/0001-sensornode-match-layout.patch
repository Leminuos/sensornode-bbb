From: Leminuos <buinguyen2804@gmail.com>
Subject: [PATCH] sensornode: match the bar position and colours
--- a/psplash-colors.h	2026-11-02 01:02:30.611083441 +0700
+++ b/psplash-colors.h	2026-11-02 01:02:30.619083205 +0700
@@ -12,15 +12,15 @@
 #define _HAVE_PSPLASH_COLORS_H
 
 /* This is the overall background color */
-#define PSPLASH_BACKGROUND_COLOR 0xec,0xec,0xe1
+#define PSPLASH_BACKGROUND_COLOR 0xeb,0xef,0xf7
 
 /* This is the color of any text output */
 #define PSPLASH_TEXT_COLOR 0x6d,0x6d,0x70
 
 /* This is the color of the progress bar indicator */
-#define PSPLASH_BAR_COLOR 0x6d,0x6d,0x70
+#define PSPLASH_BAR_COLOR 0x1d,0x4e,0xd8
 
 /* This is the color of the progress bar background */
-#define PSPLASH_BAR_BACKGROUND_COLOR 0xec,0xec,0xe1
+#define PSPLASH_BAR_BACKGROUND_COLOR 0xdd,0xe4,0xef
 
 #endif
--- a/psplash-config.h	2026-11-02 01:02:30.610083470 +0700
+++ b/psplash-config.h	2026-11-02 01:02:30.616083294 +0700
@@ -27,9 +27,9 @@
 #endif
 
 /* Position of the image split from top edge, numerator of fraction */
-#define PSPLASH_IMG_SPLIT_NUMERATOR 5
+#define PSPLASH_IMG_SPLIT_NUMERATOR 7
 
 /* Position of the image split from top edge, denominator of fraction */
-#define PSPLASH_IMG_SPLIT_DENOMINATOR 6
+#define PSPLASH_IMG_SPLIT_DENOMINATOR 9
 
 #endif
