software =
{
    version     = "@VERSION@";
    description = "SensorNode OTA update";

    @BOARD_NAME@ = {
        hardware-compatibility: [ "@HW_REVISION@" ];

        stable: {
            /* Running slot B: write slot A and trial-boot it */
            copy1: {
                images: (
                    {
                        filename           = "@IMAGE_NAME@";
                        device             = "@SLOT_A_DEV@";
                        type               = "raw";
                        compressed         = "zlib";
                        sha256             = "$swupdate_get_sha256(@IMAGE_NAME@)";
                    }
                );
                bootenv: (
                    { name = "active_slot"; value = "A"; },
                    { name = "ustate";      value = "1"; },
                    { name = "boot_count";  value = "0"; }
                );
            };

            /* Running slot A: write slot B and trial-boot it */
            copy2: {
                images: (
                    {
                        filename           = "@IMAGE_NAME@";
                        device             = "@SLOT_B_DEV@";
                        type               = "raw";
                        compressed         = "zlib";
                        sha256             = "$swupdate_get_sha256(@IMAGE_NAME@)";
                    }
                );
                bootenv: (
                    { name = "active_slot"; value = "B"; },
                    { name = "ustate";      value = "1"; },
                    { name = "boot_count";  value = "0"; }
                );
            };
        };
    };
}
