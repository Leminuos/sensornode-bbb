software =
{
    version     = "@@OTA_SW_VERSION@@";
    description = "SensorNode OTA update";

    @@OTA_BOARD_NAME@@ = {
        hardware-compatibility: [ "@@OTA_HW_REVISION@@" ];

        stable: {
            /* Running slot B: write slot A and trial-boot it */
            copy1: {
                images: (
                    {
                        filename           = "@@SENSORNODE_IMAGE@@-@@MACHINE@@.@@SENSORNODE_SLOT_FSTYPE@@.gz";
                        device             = "@@SENSORNODE_SLOT_A_DEV@@";
                        type               = "raw";
                        compressed         = "zlib";
                        sha256             = "$swupdate_get_sha256(@@SENSORNODE_IMAGE@@-@@MACHINE@@.@@SENSORNODE_SLOT_FSTYPE@@.gz)";
                    }
                );
                bootenv: (
                    { name = "active_slot"; value = "A"; },
                    { name = "ustate";      value = "1"; },
                    { name = "boot_count";  value = "0"; }
                );
            };

            /* Running slot A: write slot B and trial-boot it */
            copy2: {
                images: (
                    {
                        filename           = "@@SENSORNODE_IMAGE@@-@@MACHINE@@.@@SENSORNODE_SLOT_FSTYPE@@.gz";
                        device             = "@@SENSORNODE_SLOT_B_DEV@@";
                        type               = "raw";
                        compressed         = "zlib";
                        sha256             = "$swupdate_get_sha256(@@SENSORNODE_IMAGE@@-@@MACHINE@@.@@SENSORNODE_SLOT_FSTYPE@@.gz)";
                    }
                );
                bootenv: (
                    { name = "active_slot"; value = "B"; },
                    { name = "ustate";      value = "1"; },
                    { name = "boot_count";  value = "0"; }
                );
            };
        };
    };
}
