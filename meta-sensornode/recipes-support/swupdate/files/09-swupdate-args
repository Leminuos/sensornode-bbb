#!/bin/sh
#
# 09-swupdate-args — chạy SWUpdate flash .swu vào slot inactive. Tham số là URL
# thì SWUpdate tự tải (downloader), là đường dẫn tuyệt đối thì cài file local.
#
# Usage: 09-swupdate-args <swu-url | /path/to/file.swu>
#

set -e

url="$1"
if [ -z "$url" ]; then
    echo "usage: $(basename "$0") <swu-url | /path/to/file.swu>" >&2
    exit 2
fi

# Chọn install set theo slot đang chạy:
#   đang chạy slot A -> flash vào copy2 (slot B)
#   đang chạy slot B -> flash vào copy1 (slot A)
rootfs=$(swupdate -g)
if [ "$rootfs" = '@SLOT_A_DEV@' ]; then
    selection="-e stable,copy2"
else
    selection="-e stable,copy1"
fi

case "$url" in
    /*) exec swupdate -i "$url" -H @BOARD_NAME@:@HW_REVISION@ $selection -f /etc/swupdate.cfg ;;
    *)  exec swupdate -d "-u $url" -H @BOARD_NAME@:@HW_REVISION@ $selection -f /etc/swupdate.cfg ;;
esac
