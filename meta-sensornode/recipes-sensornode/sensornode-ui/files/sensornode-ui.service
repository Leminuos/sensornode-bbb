[Unit]
Description=SensorNode Qt HMI
After=data.mount network.target sensornode-telemetryd.service sensornode-otad.service sensornode-settingsd.service sensornode-displayd.service
Wants=data.mount sensornode-telemetryd.service sensornode-otad.service sensornode-settingsd.service sensornode-displayd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
TimeoutStartSec=30
Environment=TSLIB_TSDEVICE=/dev/input/event0
Environment=TSLIB_CONFFILE=/etc/ts.conf
Environment=TSLIB_CALIBFILE=/data/config/pointercal
Environment=TSLIB_FBDEVICE=/dev/fb0
Environment=SENSORNODE_TELEMETRY_DB=/data/telemetry/telemetry.db
ExecStartPre=-/usr/bin/psplash-write QUIT
ExecStart=/usr/bin/sensornode-ui -platform linuxfb -plugin=tslib
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
