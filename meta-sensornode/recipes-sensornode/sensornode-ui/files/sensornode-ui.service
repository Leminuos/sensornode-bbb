[Unit]
Description=SensorNode Qt HMI
After=data.mount network.target
Wants=data.mount
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=TSLIB_TSDEVICE=/dev/input/event0
Environment=TSLIB_CONFFILE=/etc/ts.conf
Environment=TSLIB_CALIBFILE=/data/config/pointercal
Environment=TSLIB_FBDEVICE=/dev/fb0
ExecStart=/usr/bin/sensornode-ui -platform linuxfb -plugin=tslib
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
