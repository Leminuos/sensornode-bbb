# Tạo sớm các thư mục của SensorNode thay vì chờ systemd-tmpfiles-setup (chạy sau journal-flush).
[Unit]
Description=Create SensorNode runtime and data directories
DefaultDependencies=no
RequiresMountsFor=/data
After=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=systemd-tmpfiles --create sensornode.conf sensornode-telemetry-data.conf
