bootloader --ptable gpt

part --source rawcopy --ondisk mmcblk0 --no-table --align 128  --sourceparams="file=MLO"
part --source rawcopy --ondisk mmcblk0 --no-table --align 384  --sourceparams="file=u-boot.img"
part --source rawcopy --ondisk mmcblk0 --no-table --align ${SENSORNODE_ENV_OFFSET_KiB} --sourceparams="file=u-boot-env.raw"
part --source rawcopy --ondisk mmcblk0 --no-table --align ${SENSORNODE_ENV_OFFSET_REDUND_KiB} --sourceparams="file=u-boot-env.raw"

part --source rawcopy --ondisk mmcblk0 --fstype=ext4 --align 4096 --fixed-size ${SENSORNODE_BOOT_SIZE_MiB} --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.bootfs"
part --source rawcopy --ondisk mmcblk0 --fstype=ext4 --align 4096 --fixed-size ${SENSORNODE_SLOT_SIZE_MiB} --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.${SENSORNODE_SLOT_FSTYPE}"
part --source rawcopy --ondisk mmcblk0 --fstype=ext4 --align 4096 --fixed-size ${SENSORNODE_DATA_SIZE_MiB} --sourceparams="file=${SENSORNODE_DATA_IMG}"
