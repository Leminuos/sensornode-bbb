From: sensornode <noreply@local>
Subject: am335x_evm: A/B boot with rollback in the built-in environment
diff --git a/include/configs/am335x_evm.h b/include/configs/am335x_evm.h
index 7fb1b3a..3f651d9 100644
--- a/include/configs/am335x_evm.h
+++ b/include/configs/am335x_evm.h
@@ -86,6 +86,31 @@
 #ifndef CONFIG_SPL_BUILD
 #include <environment/ti/dfu.h>
 
+/*
+ * A/B boot: the kernel is loaded from the active rootfs slot. With verified
+ * boot (CONFIG_FIT_SIGNATURE) it is a signed FIT image booted with bootm,
+ * otherwise a zImage + DTB pair booted with bootz.
+ */
+#ifdef CONFIG_FIT_SIGNATURE
+#define OTA_KERNEL_FILES \
+	"fit_image=/boot/fitImage\0"
+#define OTA_LOAD_KERNEL \
+	"echo OTA: loading fitImage from slot ${active_slot} (mmcblk0p${mmc_part}); " \
+	"ext4load mmc 0:${mmc_part} ${kernel_addr_r} ${fit_image}"
+#define OTA_BOOT_KERNEL \
+	"bootm ${kernel_addr_r}#conf-am335x-boneblack.dtb"
+#else
+#define OTA_KERNEL_FILES \
+	"kernel_image=/boot/zImage\0" \
+	"fdtfile=/boot/am335x-boneblack.dtb\0"
+#define OTA_LOAD_KERNEL \
+	"echo OTA: loading kernel from slot ${active_slot} (mmcblk0p${mmc_part}); " \
+	"ext4load mmc 0:${mmc_part} ${kernel_addr_r} ${kernel_image}; " \
+	"ext4load mmc 0:${mmc_part} ${fdt_addr_r} ${fdtfile}"
+#define OTA_BOOT_KERNEL \
+	"bootz ${kernel_addr_r} - ${fdt_addr_r}"
+#endif
+
 #define CONFIG_EXTRA_ENV_SETTINGS \
 	DEFAULT_LINUX_BOOT_ENV \
 	"fdtfile=undefined\0" \
@@ -152,6 +177,42 @@
 		"else " \
 			"setenv console ttyO0,115200n8;" \
 		"fi;\0" \
+	"boot_limit=3\0" \
+	"active_slot=A\0" \
+	"boot_count=0\0" \
+	"ustate=0\0" \
+	OTA_KERNEL_FILES \
+	"ota_check_rollback=" \
+		"if test \"${ustate}\" = \"1\"; then " \
+			"if test ${boot_count} -ge ${boot_limit}; then " \
+				"echo OTA: Boot failed 3 times -> rolling back; " \
+				"if test \"${active_slot}\" = \"A\"; then " \
+					"setenv active_slot B; " \
+				"else " \
+					"setenv active_slot A; " \
+				"fi; " \
+				"setenv ustate 0; " \
+				"setenv boot_count 0; " \
+				"saveenv; " \
+			"else " \
+				"setexpr boot_count ${boot_count} + 1; " \
+				"saveenv; " \
+				"echo OTA: upgrade boot attempt ${boot_count}/${boot_limit}; " \
+			"fi; " \
+		"fi\0" \
+	"ota_pick_slot=" \
+		"if test \"${active_slot}\" = \"A\"; then " \
+			"setenv mmc_part 1; " \
+		"else " \
+			"setenv mmc_part 2; " \
+		"fi\0" \
+	"ota_load_kernel=" OTA_LOAD_KERNEL "\0" \
+	"ota_boot=" \
+		"run ota_check_rollback; " \
+		"run ota_pick_slot; " \
+		"setenv bootargs root=/dev/mmcblk0p${mmc_part} ro rootwait console=ttyO0,115200n8 panic=10; " \
+		"run ota_load_kernel; " \
+		OTA_BOOT_KERNEL "\0" \
 	NANDARGS \
 	NETARGS \
 	DFUARGS \
