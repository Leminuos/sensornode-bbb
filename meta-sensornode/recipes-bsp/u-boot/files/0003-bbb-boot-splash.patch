 endif
 
 obj-y	+= board.o
+
+ifndef CONFIG_SPL_BUILD
+obj-$(CONFIG_SENSORNODE_SPLASH) += splash.o
+endif
diff --git a/board/ti/am335x/board.c b/board/ti/am335x/board.c
index e8555de..198db93 100644
