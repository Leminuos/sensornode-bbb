From: sensornode <noreply@local>
Subject: am335x_evm: show a boot splash on the ILI9341 panel
diff --git a/board/ti/am335x/Kconfig b/board/ti/am335x/Kconfig
index b66ca1a..eaa9c45 100644
--- a/board/ti/am335x/Kconfig
+++ b/board/ti/am335x/Kconfig
@@ -19,6 +19,9 @@ config NOR
 	  In practice this is seen as a NOR flash module connected to the
 	  "memory cape" for the BeagleBone family.
 
+config SENSORNODE_SPLASH
+	bool "Boot splash on the SensorNode ILI9341 panel"
+
 source "board/ti/common/Kconfig"
 
 endif
diff --git a/board/ti/am335x/Makefile b/board/ti/am335x/Makefile
index 3ccf66b..f85886d 100644
--- a/board/ti/am335x/Makefile
+++ b/board/ti/am335x/Makefile
